{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus" }
  ],
  "title": "Chronos Dispatcher Performance",
  "uid": "chronos-dispatcher",
  "tags": ["chronos", "dispatcher", "webhooks"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Executions/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(chronos_executions_total[5m])", "legendFormat": "total" },
        { "expr": "rate(chronos_executions_total{status=\"success\"}[5m])", "legendFormat": "success" },
        { "expr": "rate(chronos_executions_total{status=\"failed\"}[5m])", "legendFormat": "failed" }
      ]
    },
    {
      "title": "Success Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [{
        "expr": "sum(rate(chronos_executions_total{status=\"success\"}[5m])) / sum(rate(chronos_executions_total[5m])) * 100",
        "legendFormat": "success %"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100,
          "thresholds": { "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 90 },
            { "color": "green", "value": 99 }
          ]}
        }
      }
    },
    {
      "title": "Active Executions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "chronos_executions_active", "legendFormat": "running" }]
    },
    {
      "title": "Execution Duration (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(chronos_execution_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(chronos_execution_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(chronos_execution_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Execution Duration Heatmap",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "sum(rate(chronos_execution_duration_seconds_bucket[5m])) by (le)",
        "legendFormat": "{{le}}", "format": "heatmap"
      }]
    },
    {
      "title": "Failed Executions by Job",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{
        "expr": "topk(10, sum by (job_name) (increase(chronos_executions_total{status=\"failed\"}[24h])))",
        "legendFormat": "{{job_name}}", "instant": true, "format": "table"
      }]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39
}
